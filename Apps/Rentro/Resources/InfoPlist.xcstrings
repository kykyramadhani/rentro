    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentro uses the camera only to scan the pairing QR code shown by the rental business."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentro memakai kamera hanya untuk memindai kode QR pemasangan dari bisnis sewa."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentro shares this rental iPhone's location with the rental business you agreed to, including while the app is in the background, only while the tracking agreement is active."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentro membagikan lokasi iPhone sewaan ini ke bisnis sewa yang Anda setujui, termasuk saat aplikasi di latar belakang, hanya selama perjanjian pelacakan aktif."
          }
        }
      }
    },
