    "%@ keeps location for %lld days, then it is deleted.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ menyimpan lokasi selama %2$lld hari, lalu menghapusnya."
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "id": {
          "stringUnit": {
