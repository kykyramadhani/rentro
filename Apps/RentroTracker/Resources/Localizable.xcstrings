      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara lokasi digunakan"
          }
        }
      }
    },
    "I understand how location is collected and used.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya memahami cara lokasi dikumpulkan dan digunakan."
          }
        }
      }
    },
    "Just now": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baru saja"
          }
        }
      }
    },
    "K7M2-9QXA": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "K7M2-9QXA"
          }
        }
      }
    },
    "Last measurement": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengukuran terakhir"
          }
        }
      }
    },
    "Last sent": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terakhir dikirim"
          }
        }
      }
    },
    "Last upload": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unggahan terakhir"
          }
        }
      }
    },
    "Latitude, longitude, accuracy and time of each location update. Updates are best effort and can be delayed or missing.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lintang, bujur, akurasi, dan waktu setiap pembaruan lokasi. Pembaruan bersifat upaya terbaik dan bisa tertunda atau hilang."
          }
        }
      }
    },
    "Location Tracking": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelacakan Lokasi"
          }
        }
      }
    },
    "Location access is off. The business cannot see this iPhone's location.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses lokasi mati. Bisnis tidak dapat melihat lokasi iPhone ini."
          }
        }
      }
    },
    "Location permission": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin lokasi"
          }
        }
      }
    },
    "Location sharing stops and queued locations are deleted.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbagi lokasi berhenti dan lokasi yang mengantre dihapus."
          }
        }
      }
    },
    "Network": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaringan"
          }
        }
      }
    },
    "Never": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum pernah"
          }
        }
      }
    },
    "No location has reached the business recently. This can happen in the background, offline, or without a GPS fix.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada lokasi yang sampai ke bisnis baru-baru ini. Ini bisa terjadi di latar belakang, saat offline, atau tanpa sinyal GPS."
          }
        }
      }
    },
    "No recent signal": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada sinyal terbaru"
          }
        }
      }
    },
    "Not asked yet": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum diminta"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nanti saja"
          }
        }
      }
    },
